# Catkin and PX4 build outputs
/build/
/devel/
/external/PX4-Autopilot/build/
**/CMakeFiles/
**/CMakeCache.txt
**/catkin_make.cache
**/__pycache__/
*.py[cod]
*:Zone.Identifier
*Identifier

# Local credentials and machine-specific files
**/.env
**/.env.*
**/*.local

# Simulation output and large generated data
/start/experiments/
/start/checkpoints/
/start/logs/
**/libtommath/logs/
*.bag
*.bag.active
*.db3
*.mcap

# Editor and OS files
.DS_Store
Thumbs.db

# Local Qt experiments, runtime traces and source backups
/start/qt_work/
/start/cleanup_records/

/start/maps/
/start/inspection_records/
/start/inspection_regions/

# Building task artifacts are tied to local measured maps.
start/maps/*.topology.json
start/maps/*.inspection.json
start/maps/*.mission_progress.json*

# Local experiment markers and private model credentials
/start/ACTIVE_PATROL_EXPERIMENT
/start/private/

# Raw experiment artifacts are kept outside source control
/reports/**/stack_logs/
/reports/**/*.bag
/reports/**/*.bag.active
/reports/**/*.log
/reports/**/*.jsonl
